# Copy this file to .env for local development. Never commit .env.
OPS_ENVIRONMENT=development
OPS_DATABASE_URL=sqlite:///./data/ops.db
OPS_LOG_LEVEL=INFO
OPS_SESSION_SECRET=
OPS_SESSION_COOKIE_SECURE=false
OPS_SCHEDULER_ENABLED=false
OPS_SYNC_INTERVAL_MINUTES=60

# Spotify OAuth configuration. Leave blank until Spotify authentication is configured.
OPS_SPOTIFY_CLIENT_ID=
OPS_SPOTIFY_CLIENT_SECRET=
OPS_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

# YouTube Music OAuth client configuration. Leave blank until configured.
OPS_YTMUSIC_CLIENT_ID=
OPS_YTMUSIC_CLIENT_SECRET=

# Required for OAuth token storage. Supply this through a local secret manager
# or environment injection in production; do not commit it.
OPS_CREDENTIAL_ENCRYPTION_KEY=
