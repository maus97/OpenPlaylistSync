# Optional deployment overrides. OPS can be configured from /settings in the GUI.
# Never commit .env.
OPS_ENVIRONMENT=development
OPS_DATABASE_URL=sqlite:///./data/ops.db
OPS_DATA_DIR=data
OPS_SECRET_DIR=data
OPS_LOG_LEVEL=INFO
# Leave the local security values blank to have OPS generate them automatically.
OPS_SESSION_SECRET=
OPS_SESSION_COOKIE_SECURE=false
OPS_ALLOWED_HOSTS=127.0.0.1,localhost
# Trust forwarding headers only from exact proxy IPs or CIDRs you control.
OPS_TRUSTED_PROXY_IPS=
OPS_MAX_REQUEST_BODY_BYTES=65536
OPS_SCHEDULER_ENABLED=false
OPS_SYNC_INTERVAL_MINUTES=60

# Optional environment fallback; GUI settings take precedence.
OPS_SPOTIFY_CLIENT_ID=
OPS_SPOTIFY_CLIENT_SECRET=
OPS_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

# Optional environment fallback; GUI settings take precedence.
OPS_YTMUSIC_CLIENT_ID=
OPS_YTMUSIC_CLIENT_SECRET=

# Optional external key. If blank, OPS creates one in OPS_SECRET_DIR.
OPS_CREDENTIAL_ENCRYPTION_KEY=
